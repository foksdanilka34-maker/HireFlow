@inject HireFlowApiClient Api
@inject NavigationManager Nav

@if (error is not null)
{
    <div class="alert alert-danger">
        @foreach (var line in error.Split("; "))
        {
            <div>@line</div>
        }
    </div>
}

<form @onsubmit="SaveAsync">
    <div class="mb-3">
        <label class="form-label" for="title">Название</label>
        <input id="title" class="form-control" @bind="title" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="direction">Направление</label>
        <input id="direction" class="form-control" list="directions" @bind="direction" />
        <datalist id="directions">
            @foreach (var d in directions)
            {
                <option value="@d"></option>
            }
        </datalist>
    </div>
    <div class="mb-3">
        <label class="form-label" for="description">Описание</label>
        <textarea id="description" class="form-control" rows="4" @bind="description"></textarea>
    </div>

    <div class="border rounded p-3 mb-3">
        <h2 class="h5">Помощь ИИ</h2>
        <p>Заполните название и известные данные. ИИ предложит описание, улучшения и вопросы; перед сохранением проверьте и измените их.</p>
        <button type="button" class="btn btn-outline-primary" disabled="@(aiBusy || busy)" @onclick="SuggestAsync">@(aiBusy ? "ИИ готовит предложения…" : "Предложить улучшения и вопросы")</button>
        @if (aiError is not null) { <div class="alert alert-warning mt-2">@aiError</div> }
        @if (aiResult is { } suggestion)
        {
            <div class="mt-3">
                <strong>Предложение для описания</strong>
                <p style="white-space: pre-wrap">@suggestion.Description</p>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ApplyDescription">Использовать описание</button>
                @if (suggestion.Suggestions.Count > 0)
                {
                    <p class="mt-3 mb-1"><strong>Что можно уточнить</strong></p>
                    <ul>@foreach (var item in suggestion.Suggestions) { <li>@item</li> }</ul>
                }
                @if (suggestion.Questions.Count > 0)
                {
                    <p class="mt-3 mb-1"><strong>Предложенные вопросы</strong></p>
                    <ul>@foreach (var item in suggestion.Questions) { <li>@item.Text @if (!string.IsNullOrWhiteSpace(item.Criterion)) { <span> — @item.Criterion</span> }</li> }</ul>
                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(questionsApplied || questions.Count >= 10)" @onclick="ApplyQuestions">Добавить предложенные вопросы</button>
                }
                <p class="form-text mt-2">ИИ может ошибаться или добавить лишнее. Вопросы необязательны: их можно не добавлять или удалить ниже.</p>
            </div>
        }
    </div>

    <h2 class="h5">Обязательные навыки</h2>
    <SkillRows Rows="required" />
    <h2 class="h5">Желательные навыки</h2>
    <SkillRows Rows="niceToHave" />
    <p class="form-text">Добавьте навык, характерный для этой роли. Синонимы — через запятую.</p>

    <h2 class="h5">Уточняющие вопросы</h2>
    <p class="form-text">После скрининга бот задаст вопросы по очереди. Критерий поможет ИИ сравнить ответ с ожиданиями.</p>
    @foreach (var q in questions)
    {
        <div class="border rounded p-2 mb-2" @key="q">
            <label class="form-label">Вопрос</label>
            <input class="form-control mb-2" maxlength="500" @bind="q.Text" />
            <label class="form-label">Ожидаемый ответ или критерий</label>
            <input class="form-control mb-2" maxlength="1000" @bind="q.Criterion" />
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => questions.Remove(q)">Убрать вопрос</button>
        </div>
    }
    <button type="button" class="btn btn-outline-secondary mb-3" disabled="@(questions.Count >= 10)" @onclick="() => questions.Add(new QuestionRow())">Добавить вопрос</button>

    <div class="row mb-3">
        <div class="col-sm-4">
            <label class="form-label" for="years">Мин. опыт (лет)</label>
            <input id="years" type="number" min="0" class="form-control" @bind="minYears" />
        </div>
        <div class="col-sm-4">
            <label class="form-label" for="score">Проходной балл</label>
            <input id="score" type="number" min="0" max="100" class="form-control" @bind="passingScore" />
        </div>
        <div class="col-sm-4">
            <label class="form-label" for="borderline">Ширина пограничной зоны</label>
            <input id="borderline" type="number" min="0" max="100" class="form-control" @bind="borderlineWidth" />
        </div>
    </div>

    <button type="submit" class="btn btn-primary me-2" disabled="@(busy || aiBusy)">Сохранить</button>
    <a class="btn btn-outline-secondary" href="vacancies">Отмена</a>
</form>

@code {
    private const int DefaultFreezePeriodDays = 90;

    // Редактируемая вакансия; null — создание новой.
    [Parameter]
    public VacancyDto? Vacancy { get; set; }

    private string title = "";
    private string direction = "";
    private string? description;
    private List<SkillRow> required = [new()];
    private List<SkillRow> niceToHave = [new()];
    private sealed class QuestionRow { public string Text { get; set; } = ""; public string? Criterion { get; set; } }
    private List<QuestionRow> questions = [];
    private int minYears;
    private int passingScore = 70;
    private int borderlineWidth = 10;
    private List<string> directions = [];
    private string? error;
    private bool busy;
    private bool aiBusy;
    private bool questionsApplied;
    private string? aiError;
    private VacancyAiResultDto? aiResult;

    private async Task SuggestAsync()
    {
        aiError = null;
        if (string.IsNullOrWhiteSpace(title)) { aiError = "Укажите название вакансии."; return; }
        aiBusy = true;
        try
        {
            var request = new VacancyAiRequestDto(title.Trim(), direction.Trim(), description,
                SkillInput.ToSkills(required).Select(s => s.Name).ToList(),
                SkillInput.ToSkills(niceToHave).Select(s => s.Name).ToList(), minYears);
            var result = await Api.SuggestVacancyAsync(request);
            if (!result.IsOk || result.Value is null) { aiError = result.Error ?? "Не удалось получить предложения ИИ."; return; }
            aiResult = result.Value;
            questionsApplied = false;
        }
        finally { aiBusy = false; }
    }

    private void ApplyDescription() { if (aiResult is not null) description = aiResult.Description; }
    private void ApplyQuestions()
    {
        if (aiResult is null || questionsApplied) return;
        questions.AddRange(aiResult.Questions.Take(10 - questions.Count).Select(q => new QuestionRow { Text = q.Text, Criterion = q.Criterion }));
        questionsApplied = true;
    }

    // Заполняет форму и загружает направления для подсказки.
    protected override async Task OnInitializedAsync()
    {
        if (Vacancy is not null)
        {
            title = Vacancy.Title;
            direction = Vacancy.Direction;
            description = Vacancy.Description;
            required = SkillInput.ToRows(Vacancy.Requirements.RequiredSkills);
            niceToHave = SkillInput.ToRows(Vacancy.Requirements.NiceToHaveSkills);
            minYears = Vacancy.Requirements.MinYearsOfExperience;
            passingScore = Vacancy.Requirements.PassingScore;
            borderlineWidth = Vacancy.Requirements.BorderlineWidth;
            questions = (Vacancy.Questions ?? []).Select(q => new QuestionRow { Text = q.Text, Criterion = q.Criterion }).ToList();
        }

        var all = await Api.GetVacanciesAsync();
        if (all.IsOk)
            directions = all.Value!.Select(v => v.Direction).Distinct(StringComparer.OrdinalIgnoreCase).Order().ToList();
    }

    // Сохраняет вакансию и возвращает к списку; ошибки API показывает над формой.
    private async Task SaveAsync()
    {
        busy = true;
        error = null;
        var request = new VacancyRequestDto(
            title.Trim(),
            direction.Trim(),
            string.IsNullOrWhiteSpace(description) ? null : description.Trim(),
            new RequirementsDto(SkillInput.ToSkills(required), SkillInput.ToSkills(niceToHave), minYears, passingScore, borderlineWidth),
            Vacancy?.FreezePeriodDays ?? DefaultFreezePeriodDays,
            questions.Select(q => new VacancyQuestionDto(q.Text.Trim(), string.IsNullOrWhiteSpace(q.Criterion) ? null : q.Criterion.Trim())).ToList());

        var result = Vacancy is null
            ? await Api.CreateVacancyAsync(request)
            : await Api.UpdateVacancyAsync(Vacancy.Id, request);
        busy = false;

        if (!result.IsOk)
        {
            error = result.Error;
            return;
        }
        Nav.NavigateTo("vacancies");
    }
}
