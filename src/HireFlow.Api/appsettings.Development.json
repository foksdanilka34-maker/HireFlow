{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Storage": {
    "LocalPath": "../../storage"
  },
  "Notifications": {
    "RejectionDelay": "00:01:00"
  },
  "ResumeUploads": {
    "DailyLimit": 20
  },
  "RecruiterAuth": {
    "SessionLifetime": "08:00:00",
    "LoginAttemptsPerMinute": 20
  },
  "Web": {
    "Origins": ["http://localhost:5200"]
  },
  "Telemetry": {}
}
