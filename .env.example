# Локальный стенд HireFlow. Скопируйте в .env (он в .gitignore) и подставьте свой токен бота.
# Значения ниже — только для локальной разработки, перед выкладкой их нужно сменить.
#
# docker compose читает .env сам (POSTGRES_PASSWORD).
# dotnet run .env не читает — перед запуском API и бота загрузите переменные в shell:
#   set -a; source .env; set +a
#   dotnet run --project src/HireFlow.Api
#   dotnet run --project src/HireFlow.Bot
# Вместо этого можно положить те же значения в user secrets (dotnet user-secrets set "Bot:TelegramToken" ...).

# PostgreSQL (docker-compose.yml)
POSTGRES_PASSWORD=hireflow-local

# API: строка подключения (пароль — тот же, что выше)
# Кавычки обязательны: без них shell при source примет «;» за конец команды
ConnectionStrings__Postgres="Host=localhost;Database=hireflow;Username=hireflow;Password=hireflow-local"

# Служебный ключ бота: одно и то же значение для API и бота
BotApi__ApiKey=hireflow-local-bot-key
Bot__ApiKey=hireflow-local-bot-key

# Токен бота от @BotFather (/newbot) — настоящий токен только в .env, не в этом файле
Bot__TelegramToken=123456789:replace-with-token-from-botfather
