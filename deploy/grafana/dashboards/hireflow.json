{
  "uid": "hireflow",
  "title": "HireFlow",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "hireflow"
  ],
  "panels": [
    {
      "id": 12,
      "type": "row",
      "title": "SLO",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Доступность API за 30 дней, цель 99,5% (данные — 7 дней)",
      "description": "Доля ответов без 5xx, без /health*. Prometheus хранит 7 дней, поэтому фактически окно — срок хранения.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - ((sum(increase(http_server_request_duration_seconds_count{service_name=\"hireflow-api\", http_route!~\"/health.*\", http_response_status_code=~\"5..\"}[30d])) or vector(0)) / sum(increase(http_server_request_duration_seconds_count{service_name=\"hireflow-api\", http_route!~\"/health.*\"}[30d])))",
          "legendFormat": "доступность",
          "instant": true
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Остаток бюджета ошибок за 30 дней (данные — 7 дней)",
      "description": "Бюджет — 0,5% запросов с 5xx. Меньше 0 — SLO нарушено.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - ((sum(increase(http_server_request_duration_seconds_count{service_name=\"hireflow-api\", http_route!~\"/health.*\", http_response_status_code=~\"5..\"}[30d])) or vector(0)) / sum(increase(http_server_request_duration_seconds_count{service_name=\"hireflow-api\", http_route!~\"/health.*\"}[30d]))) / 0.005",
          "legendFormat": "остаток",
          "instant": true
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Burn rate API: 1 ч и 6 ч (алерты: 14.4 и 6)",
      "description": "Во сколько раз быстрее допустимого тратится бюджет ошибок. 1 — бюджет кончится ровно за 30 дней.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:api_request_errors:ratio_rate1h / 0.005",
          "legendFormat": "1 ч"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:api_request_errors:ratio_rate6h / 0.005",
          "legendFormat": "6 ч"
        }
      ]
    },
    {
      "id": 16,
